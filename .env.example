# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Midtrans
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=

# Optional external downloader worker. Do not point this to an untrusted service.
DOWNLOADER_WORKER_URL=
DOWNLOADER_WORKER_TOKEN=

# Admin accounts for knowledge-base management
ADMIN_EMAILS=
ADMIN_USER_IDS=

# Optional cron secret for automatic subscription expiry reconciliation
CRON_SECRET=
