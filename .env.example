# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Midtrans
MIDTRANS_SERVER_KEY=YOUR_MIDTRANS_SERVER_KEY
MIDTRANS_IS_PRODUCTION=false

# Optional external downloader worker. Do not point this to an untrusted service.
DOWNLOADER_WORKER_URL=
DOWNLOADER_WORKER_TOKEN=

# Manual DANA payment
DANA_ACCOUNT_NAME=
DANA_ACCOUNT_NUMBER=

# Comma-separated admin accounts
ADMIN_EMAILS=
ADMIN_USER_IDS=

# Monetisasi iklan (opsional) — isi dengan ID klien AdSense, contoh: ca-pub-1234567890
NEXT_PUBLIC_ADSENSE_CLIENT=
