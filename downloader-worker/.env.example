# Secret yang sama harus dipasang di Render dan Vercel.
WORKER_TOKEN=generate-a-long-random-secret

# Wajib untuk download file. Isi dengan URL public service worker.
# PUBLIC_BASE_URL=https://nexora-downloader.onrender.com
PUBLIC_BASE_URL=

MAX_VIDEO_DURATION_SECONDS=1200
MAX_FILE_SIZE_MB=250
FILE_TTL_SECONDS=1800
MAX_CONCURRENT_DOWNLOADS=1
